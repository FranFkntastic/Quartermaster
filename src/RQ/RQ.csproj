<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Title>Quartermaster</Title>
    <Description>Retainer Quartermaster (RQ) provides owner-scoped retainer stock, target plans, and reviewed transfers.</Description>
    <AssemblyName>RQ</AssemblyName>
    <RootNamespace>RQ</RootNamespace>
    <Version>0.2.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Franthropy.Dalamud" Version="[$(FranthropyPackageVersion)]" Condition="'$(FranthropySource)' == 'Package'" />
    <ProjectReference Include="$(FranthropyRoot)/src/Franthropy.Dalamud/Franthropy.Dalamud.csproj" Condition="'$(FranthropySource)' == 'Local'" />
    <PackageReference Include="Franthropy.FFXIV" Version="[$(FranthropyPackageVersion)]" Condition="'$(FranthropySource)' == 'Package'" />
    <ProjectReference Include="$(FranthropyRoot)/src/Franthropy.FFXIV/Franthropy.FFXIV.csproj" Condition="'$(FranthropySource)' == 'Local'" />
    <PackageReference Include="Franthropy.Observations" Version="[$(FranthropyPackageVersion)]" Condition="'$(FranthropySource)' == 'Package'" />
    <ProjectReference Include="$(FranthropyRoot)/src/Franthropy.Observations/Franthropy.Observations.csproj" Condition="'$(FranthropySource)' == 'Local'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RQ.Tests" />
  </ItemGroup>


  <Target Name="RejectDebugProjectReferencesInRelease" AfterTargets="ResolveProjectReferences" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_DebugProjectReference Include="@(_ResolvedProjectReferencePaths)" Condition="$([System.String]::Copy('%(FullPath)').Contains('\bin\Debug\'))" />
    </ItemGroup>
    <Error Condition="'@(_DebugProjectReference)' != ''" Text="Release build resolved Debug project output: @(_DebugProjectReference)." />
  </Target>

  <!-- Dalamud loads development plugins from a flat watched directory. Keep
       SQLite's x64 native provider beside RQ.dll so deployment does not depend
       on NuGet's nested runtime layout or another plugin loading it first. -->
  <Target Name="FlattenSqliteNativeRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)runtimes\win-x64\native\e_sqlite3.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)runtimes\win-x64\native\e_sqlite3.dll')" />
    <Error Condition="!Exists('$(OutDir)e_sqlite3.dll')"
           Text="SQLite's x64 native runtime was not produced beside RQ.dll." />
  </Target>
</Project>
