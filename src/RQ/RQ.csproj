<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Title>Quartermaster</Title>
    <Description>Retainer Quartermaster (RQ) provides owner-scoped retainer stock, target plans, and reviewed transfers.</Description>
    <AssemblyName>RQ</AssemblyName>
    <RootNamespace>RQ</RootNamespace>
    <Version>0.2.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <FranthropyRoot Condition="'$(FranthropyRoot)' == ''">..\..\..\Franthropy</FranthropyRoot>
    <FranthropyDalamudProject Condition="'$(FranthropyDalamudProject)' == ''">$(FranthropyRoot)\src\Franthropy.Dalamud\Franthropy.Dalamud.csproj</FranthropyDalamudProject>
    <FranthropyFfxivProject Condition="'$(FranthropyFfxivProject)' == ''">$(FranthropyRoot)\src\Franthropy.FFXIV\Franthropy.FFXIV.csproj</FranthropyFfxivProject>
    <FranthropyObservationsProject Condition="'$(FranthropyObservationsProject)' == ''">$(FranthropyRoot)\src\Franthropy.Observations\Franthropy.Observations.csproj</FranthropyObservationsProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <ProjectReference Include="$(FranthropyDalamudProject)" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="$(FranthropyFfxivProject)" SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="$(FranthropyObservationsProject)" SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RQ.Tests" />
  </ItemGroup>

  <Target Name="ValidateFranthropyProjects" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(FranthropyDalamudProject)')" Text="Franthropy.Dalamud was not found at '$(FranthropyDalamudProject)'. Clone Franthropy beside Quartermaster or set FranthropyDalamudProject." />
    <Error Condition="!Exists('$(FranthropyFfxivProject)')" Text="Franthropy.FFXIV was not found at '$(FranthropyFfxivProject)'. Clone Franthropy beside Quartermaster or set FranthropyFfxivProject." />
    <Error Condition="!Exists('$(FranthropyObservationsProject)')" Text="Franthropy.Observations was not found at '$(FranthropyObservationsProject)'. Clone Franthropy beside Quartermaster or set FranthropyObservationsProject." />
  </Target>

  <Target Name="RejectDebugProjectReferencesInRelease" AfterTargets="ResolveProjectReferences" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_DebugProjectReference Include="@(_ResolvedProjectReferencePaths)" Condition="$([System.String]::Copy('%(FullPath)').Contains('\bin\Debug\'))" />
    </ItemGroup>
    <Error Condition="'@(_DebugProjectReference)' != ''" Text="Release build resolved Debug project output: @(_DebugProjectReference)." />
  </Target>

  <!-- Dalamud loads development plugins from a flat watched directory. Keep
       SQLite's x64 native provider beside RQ.dll so deployment does not depend
       on NuGet's nested runtime layout or another plugin loading it first. -->
  <Target Name="FlattenSqliteNativeRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)runtimes\win-x64\native\e_sqlite3.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)runtimes\win-x64\native\e_sqlite3.dll')" />
    <Error Condition="!Exists('$(OutDir)e_sqlite3.dll')"
           Text="SQLite's x64 native runtime was not produced beside RQ.dll." />
  </Target>
</Project>
